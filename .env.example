# ═══════════════════════════════════════════════════════════════
#  World Viewer – Zugangsdaten für den Server
# ═══════════════════════════════════════════════════════════════
#
#  ⚠️  DIESE DATEI NIEMALS IN EIN GIT-REPOSITORY EINCHECKEN.
#      Sie steht in .gitignore – bitte dort lassen.
#
#  Diese Werte liest ausschließlich der Server (server/server.mjs).
#  Sie landen NIE im Browser.
#
#  Gesetzte Umgebungsvariablen haben Vorrang, ein
#      FIRMS_MAP_KEY=... node server/server.mjs
#  überschreibt also den Wert hier.
# ═══════════════════════════════════════════════════════════════

# ── Karten-Token (nur beim Hosting nötig) ─────────────────────
# Lokal stehen diese beiden Werte in config.js. Beim Hosting soll
# dort nichts Persönliches liegen – dann trägt der Server sie aus
# diesen Variablen in die ausgelieferte config.js nach.
# CESIUM_ION_TOKEN=
# GOOGLE_MAPS_API_KEY=


# ── Aktive Brände (NASA FIRMS) ────────────────────────────────
# Kostenlos: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=


# ── KI-Assistent (Anthropic Claude) ───────────────────────────
# https://console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=sk-ant-...


# ── Flugdaten ─────────────────────────────────────────────────
# Anbieter erzwingen: opensky (Standard) | adsblol | fr24
# FLIGHT_PROVIDER=opensky

# Mehr Kontingent bei OpenSky (kostenloses Konto):
# https://opensky-network.org → My OpenSky → OAuth2 Clients
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=

# Flightradar24 (kostenpflichtiges Abo):
# https://fr24api.flightradar24.com
# FR24_API_TOKEN=

# Militärflüge (WEB-90): immer über adsb.lol, kein Schlüssel nötig.
# Server-Cache in Millisekunden, Default 20000 (weltweiter Feed, kein
# Bounding-Box-Cache wie beim zivilen Verkehr nötig).
# MILITARY_FLIGHT_CACHE_MS=20000


# ── Schiffsdaten (AIS via AISStream) ──────────────────────────
# Kostenlos: https://aisstream.io → Account → API Keys
AISSTREAM_API_KEY=

# Optional: Bounding-Box eng begrenzen statt Weltmeer (south,west,north,east).
# Reduziert Nachrichtenmenge und Speicher spürbar, z.B. Nordsee/Kanal:
# AISSTREAM_BBOX=48,-6,62,10

# Obergrenze für gleichzeitig gespeicherte Schiffe (Standard: 1000)
# AISSTREAM_MAX_SHIPS=1000


# ── Weitere Kontingent-Erhöhungen (alle optional) ─────────────
# Raketenstarts: https://ll.thespacedevs.com/docs/
# LL2_API_TOKEN=

# Asteroiden (NASA NeoWs): läuft ohne Eintrag mit DEMO_KEY (30 Abrufe/Stunde,
# geteilt mit allen DEMO_KEY-Nutzern weltweit). Eigener Key kostenlos+sofort:
# https://api.nasa.gov → Generate API Key (1000 Abrufe/Stunde)
# NASA_API_KEY=

# Londoner Kameras: https://api-portal.tfl.gov.uk
# TFL_APP_KEY=

# Welche Caltrans-Distrikte geladen werden (Standard: 4,7,11,3)
# CCTV_CALTRANS_DISTRICTS=4,7,11,3


# ── Street-Level-Fotos (Mapillary) ────────────────────────────
# Kostenlos: https://www.mapillary.com/dashboard/developers
# → "Register application" → liefert einen Client-Token (MLY|...).
# Bleibt auf dem Server (WEB-95) – der Browser bekommt ihn nur transient
# beim Öffnen des Bildbetrachters über /api/mapillary/token.
# MAPILLARY_TOKEN=


# ── Verkehrsfluss (TomTom, optional – WEB-93) ─────────────────
# Der Verkehrs-Layer simuliert Fahrzeuge auf einem Straßenraster auch
# OHNE diesen Key. Erst MIT Key färbt er einzelne Straßen mit echten
# Geschwindigkeiten ein. Kostenlos: https://developer.tomtom.com
# TOMTOM_API_KEY=

# Tagesbudget für TomTom-Abrufe (Gratis-Tier: 2.500/Tag, Standard hier
# lässt bewusst Luft für mehrere gleichzeitig offene Browser-Tabs).
# TOMTOM_DAILY_BUDGET=2000
